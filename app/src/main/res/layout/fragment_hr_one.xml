<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.main.hrRequestsFragments.HrFragmentOne">

    <!-- My Permissions -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_my_permissions"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:backgroundTint="#5CBC6C"
        app:cardCornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/cv_we_hear_you"
        app:layout_constraintEnd_toStartOf="@+id/cv_we_hear_you"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cv_we_hear_you">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"

            android:src="@drawable/ic_we_hear_you" />
    </androidx.cardview.widget.CardView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_marginEnd="2dp"
        android:background="@drawable/notification_dot"
        app:layout_constraintBottom_toBottomOf="@+id/tv_my_documents"
        app:layout_constraintEnd_toStartOf="@+id/tv_my_documents"
        app:layout_constraintTop_toTopOf="@+id/tv_my_documents">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/alexandria_regular"
            android:text="22"
            android:textColor="@color/white"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tv_my_permissions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="عمل عن بعد"
        android:textAppearance="@style/Regular11"
        android:textColor="@color/yankee_blue"
        app:layout_constraintEnd_toEndOf="@+id/cv_my_permissions"
        app:layout_constraintStart_toStartOf="@+id/cv_my_permissions"
        app:layout_constraintTop_toBottomOf="@+id/cv_my_permissions" />


    <!-- We Hear You -->

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_we_hear_you"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:backgroundTint="#679CC8"
        app:cardCornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/cv_my_documents"
        app:layout_constraintEnd_toStartOf="@+id/cv_my_documents"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/cv_my_permissions"
        app:layout_constraintTop_toTopOf="@+id/cv_my_documents"
        app:layout_constraintVertical_bias="0.0">

        <ImageView
            android:layout_width="25dp"
            android:layout_height="19dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_we_hear_you" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_we_hear_you"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="إجازاتي"
        android:textAppearance="@style/Regular11"
        android:textColor="@color/yankee_blue"
        app:layout_constraintEnd_toEndOf="@+id/cv_we_hear_you"
        app:layout_constraintStart_toStartOf="@+id/cv_we_hear_you"
        app:layout_constraintTop_toBottomOf="@+id/cv_we_hear_you" />


    <!-- My Commitments -->

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_my_commitments"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:backgroundTint="#F5A158"
        app:cardCornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/cv_my_documents"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_we_hear_you" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_my_commitments"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="سجل حضوري"
        android:textAppearance="@style/Regular11"
        android:textColor="@color/yankee_blue"
        app:layout_constraintEnd_toEndOf="@+id/cv_my_commitments"
        app:layout_constraintStart_toStartOf="@+id/cv_my_commitments"
        app:layout_constraintTop_toBottomOf="@+id/cv_my_commitments" />


    <!-- My Documents -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_my_documents"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:backgroundTint="#E7636F"
        app:cardCornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/cv_my_commitments"
        app:layout_constraintEnd_toStartOf="@+id/cv_my_commitments"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/cv_we_hear_you"
        app:layout_constraintTop_toTopOf="@+id/cv_my_commitments">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_we_hear_you" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_my_documents"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="اعتماداتي"
        android:textAppearance="@style/Regular11"
        android:textColor="@color/yankee_blue"
        app:layout_constraintEnd_toEndOf="@+id/cv_my_documents"
        app:layout_constraintStart_toStartOf="@+id/cv_my_documents"
        app:layout_constraintTop_toBottomOf="@+id/cv_my_documents" />

</androidx.constraintlayout.widget.ConstraintLayout>
