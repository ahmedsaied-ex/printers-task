<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="210dp"
    android:paddingRight="16dp"

    android:layout_height="220dp">

    <androidx.cardview.widget.CardView
        android:backgroundTint="@color/white"
        android:layout_width="match_parent"
        app:cardCornerRadius="10dp"
        android:layoutDirection="ltr"
        android:layout_height="212dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/iv_thumb_nail"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/offer_image" />

            <TextView
                android:id="@+id/tv_head_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="خصم 25% على اجمالي ا..."
                android:textAppearance="@style/semiBold"
                android:textColor="@color/yankee_blue"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_thumb_nail" />

            <TextView
                android:id="@+id/textView26"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="أونلاين"
                android:textAppearance="@style/Regular11"
                android:textColor="#6B6D85"
                app:layout_constraintEnd_toStartOf="@+id/imageView16"
                app:layout_constraintTop_toTopOf="@+id/imageView16" />

            <ImageView
                android:id="@+id/imageView16"
                android:layout_width="16sp"
                android:layout_height="16sp"
                android:layout_marginTop="10dp"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="@+id/tv_head_text"
                app:layout_constraintTop_toBottomOf="@+id/tv_head_text"
                app:srcCompat="@drawable/ic_grocery"
                app:tint="#BBBCC7" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardView5"
                android:layout_width="51dp"
                android:layout_height="51dp"
                android:layout_marginEnd="28dp"
                android:layout_marginBottom="76dp"
                android:backgroundTint="@color/white"
                android:elevation="8dp"
                app:cardCornerRadius="30dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/iv_market_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/jarir" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/market_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="19dp"
                android:text="مكتبة جرير"
                android:textAppearance="@style/medium"
                android:textColor="#6B6D85"
                android:textSize="11sp"
                app:layout_constraintBottom_toTopOf="@+id/tv_head_text"
                app:layout_constraintEnd_toStartOf="@+id/cardView5" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>