<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:background="@color/white"
    android:paddingRight="16dp"
    android:layout_height="120dp">


    <ImageView
        android:id="@+id/iv_offer_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/offers_item_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_restaurants" />

    <TextView
        android:id="@+id/tv_offer_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textAppearance="@style/medium"
        android:textColor="@color/yankee_blue"
        android:text="مطاعم"
        app:layout_constraintEnd_toEndOf="@+id/iv_offer_img"
        app:layout_constraintStart_toStartOf="@+id/iv_offer_img"
        app:layout_constraintTop_toBottomOf="@+id/iv_offer_img" />
</androidx.constraintlayout.widget.ConstraintLayout>