<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/fr_fourth"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.onBoarding.FragmentFour"
    android:fitsSystemWindows="true">


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="140dp" />

    <ImageView
        android:id="@+id/iv_cloud"
        android:layout_width="match_parent"
        android:layout_height="215dp"
        android:src="@drawable/trans_cloud"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guideline" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cd_amjad"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_marginHorizontal="10dp"
        android:backgroundTint="@color/card_background"
        android:paddingHorizontal="50dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_cloud">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layoutDirection="ltr">

            <View
                android:id="@+id/view"
                android:layout_width="120dp"
                android:layout_height="160dp"
                android:layout_marginStart="88dp"
                android:background="@drawable/back_amjad"
                android:clipToOutline="true"
                android:rotation="-40"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/view2"
                android:layout_width="70dp"
                android:layout_height="160dp"
                android:background="@drawable/back_amjad"
                android:clipToOutline="true"
                android:rotation="-40"
                app:layout_constraintStart_toStartOf="parent"
                tools:layout_editor_absoluteY="-15dp"
                tools:ignore="MissingConstraints" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:text="أنا أمجاد"
                android:textAppearance="@style/HeadText"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textView5"
                android:layout_width="137dp"
                android:layout_height="77dp"
                android:lineSpacingExtra="5dp"

                android:text="مستشارة آلية مدعومة بالذكاء الاصطناعي مهمتا الأولى تحسين تجربه الموظف"
                android:textAppearance="@style/AmjadSubText"
                app:layout_constraintEnd_toEndOf="@+id/textView4"
                app:layout_constraintTop_toBottomOf="@+id/textView4" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <ImageView

        android:layoutDirection="ltr"
        android:id="@+id/imageView5"
        android:layout_width="153dp"
        android:layout_height="212dp"
        android:layout_marginStart="15dp"
        android:elevation="8dp"
        android:scaleType="centerCrop"
        android:src="@drawable/amjad"
        app:layout_constraintBottom_toBottomOf="@+id/cd_amjad"
        app:layout_constraintStart_toStartOf="@+id/cd_amjad" />



</androidx.constraintlayout.widget.ConstraintLayout>