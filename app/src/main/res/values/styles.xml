<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AmjadSubText" parent="@style/TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/alexandria_semibold</item>

        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/main_back_ground_Color</item>
    </style>

    <style name="SubText" parent="@style/TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/alexandria_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:textColor">@color/text_color</item>
    </style>
    <style name="HeadText" parent="@style/TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/alexandria_bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/main_back_ground_Color</item>
    </style>
    <style name="Regular" parent="@style/TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/alexandria_regular</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/main_back_ground_Color</item>
    </style>
    <style name="semiBold" parent="@style/TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/alexandria_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/main_back_ground_Color</item>
    </style>
    <style name="medium" parent="@style/TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/alexandria_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#287676</item>
    </style>
    <style name="CircularImageStyle">
        <item name="color">#FF3600</item>
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="Regular11" parent="@style/TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/alexandria_regular</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/body_text_color</item>
    </style>
    <style name="Amjad_consultant_card_font" parent="@style/TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/alexandria_light</item>
        <item name="android:textSize">7sp</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="CircleImageStyle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="NoIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>
</resources>
